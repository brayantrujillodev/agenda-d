<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Sin proyecto padre agregador (ver CLAUDE.md: "Cada servicio tiene su
        propio pom.xml. No hay proyecto padre"). El <relativePath/> vacío evita
        que Maven busque un pom.xml en la carpeta superior: va directo al
        repositorio por spring-boot-starter-parent.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>co.edu.fet.agendad</groupId>
    <artifactId>notificaciones-service</artifactId>
    <version>0.1.0</version>
    <name>notificaciones-service</name>
    <description>
        Consumidor Kafka de citas.reservadas y citas.canceladas para AGENDA-D.
        Fase 2 (issue #10): guarda el aviso en notificaciones.programacion con
        el adaptador REGISTRO. Sin recordatorios todavía (Fase 3, issue #18).
    </description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- /actuator/health, igual que los demás servicios del monorepo -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Persistencia contra el esquema notificaciones ya creado por db/V1__esquema_inicial.sql -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Consumidor Kafka -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- Pruebas: unitarias con Mockito, sin infraestructura real todavía (Testcontainers es Fase 3) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
