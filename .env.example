# AGENDA-D · variables de ejemplo.
# Copia este archivo a `.env` (cp .env.example .env) solo si quieres cambiar
# algo: cada variable ya tiene el mismo valor por defecto en docker-compose.yml,
# así que el proyecto arranca igual sin crear ningún .env.
# Todos los valores son de desarrollo local y ficticios. No hay secretos reales.

# --- PostgreSQL (contenedor agd-postgres) ---
DB_NAME=agendad
DB_USER=agendad
DB_PASSWORD=agendad

# --- pgAdmin (solo desarrollo; sin login en la imagen configurada) ---
PGADMIN_EMAIL=admin@agendad.com
PGADMIN_PASSWORD=agendad

# --- Despliegue con docker-compose.prod.yml (servidor) ---
# GHCR_REPO=ghcr.io/brayantrujillodev/agenda-d
# TAG=v1.0.2
# POSTGRES_PASSWORD=cambia-esto-en-produccion
